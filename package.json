{
  "name": "@railgun-reloaded/wallet-sdk",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./node": {
      "types": "./src/node/index.d.ts",
      "default": "./src/node/index.js"
    },
    "./browser": {
      "types": "./src/browser/index.d.ts",
      "default": "./src/browser/index.js"
    }
  },
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts"
  ],
  "scripts": {
    "lint": "eslint",
    "fix": "eslint --fix",
    "build": "tsc --build",
    "prepare": "tsc --build",
    "clean": "tsc --build --clean && find src test -type f \\( -name '*.js' -o -name '*.d.ts' -o -name '*.d.ts.map' \\) -delete && rm -f tsconfig.tsbuildinfo tsconfig.test.tsbuildinfo",
    "rebuild": "npm run clean && npm run build",
    "fixture:browser:load-balances": "node config/check-browser-load-balances-fixture.mjs",
    "pretest": "npm run rebuild",
    "test": "node --test --enable-source-maps test/*.test.js test/**/*.test.js",
    "db:generate:chain": "db-generate-chain"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/railgun-reloaded/wallet-sdk.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/railgun-reloaded/wallet-sdk/issues"
  },
  "homepage": "https://github.com/railgun-reloaded/wallet-sdk#readme",
  "devDependencies": {
    "@railgun-reloaded/eslint-config": "^1.1.0",
    "@railgun-reloaded/tsconfig": "^1.2.0",
    "better-sqlite3": "^11.10.0",
    "eslint": "^9.24.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@railgun-reloaded/0zk-addresses": "git+https://github.com/railgun-reloaded/0zk-addresses.git#dev",
    "@railgun-reloaded/balance-scanner": "git+https://github.com/railgun-reloaded/balance-scanner.git#dev",
    "@railgun-reloaded/bytes": "git+https://github.com/railgun-reloaded/bytes.git#dev",
    "@railgun-reloaded/cryptography": "git+https://github.com/railgun-reloaded/cryptography.git#dev",
    "@railgun-reloaded/merkle-tree": "git+https://github.com/railgun-reloaded/merkle-tree.git#dev",
    "@railgun-reloaded/scanner": "git+https://github.com/railgun-reloaded/scanner.git#dev",
    "@railgun-reloaded/storage": "git+https://github.com/railgun-reloaded/storage.git#dev",
    "@railgun-reloaded/wallet-node": "git+https://github.com/railgun-reloaded/wallet-node.git#dev",
    "viem": "^2.31.4"
  },
  "peerDependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  }
}
